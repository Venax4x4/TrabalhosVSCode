programa
{
	
	funcao inicio()
	{
		inteiro idade
		/*
		escreva("/nInforme sua idade")
		leia(idade)
		enquanto(idade<18){
			escreva("Entrada não permitida")
			escreva("/nInforme sua idade")
			leia(idade)
		}
		*/

		//faça/enquanto (do/while)
		faca{
			escreva("\nInforme sua idade (Valores aceitos de 5 a 150 anos): ")
			leia(idade)
		}enquanto(idade < 5 ou idade > 150)

		escreva("\nIdade correta")
	}
}

