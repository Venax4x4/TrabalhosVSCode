programa
{
	
	funcao inicio()
	{
		//para(for) é elemento de repetição (loop)
		inteiro numero, contador


		/*Para é compposto por 3 elementos, o primero é a inicialização,
		 	segundo é a condição é o incremento ou decremento.
		 	Todos separados por ponto e virgula.
		 */
		cadeia nome
		para(contador=1; contador <=5; contador++){
			escreva("\nInforme o nome do aluno: ")
			leia(nome)
			escreva("\n",nome)
		}
	}
}
