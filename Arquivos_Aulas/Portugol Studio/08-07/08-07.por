programa
{
	funcao inicio()
	{
		//Variavel
		//Tipo String = tipo texto
		//No portugal Studio usamos tipo cadeia
		//Minha variavel do tipo cidade é do tipo cadeia, ou seja, texto
		cadeia cidade = "Santa Cruz do Sul"
		//O igual(=) é a atribuição do valor que vou dar para minha variavel
		//Na variavel cidade o tipo cadeia(texto) definimos o seu valor como Santa Cruz do Sul
		//Quando definimos o valor de uma variavel tipo precisamos colocar entre apas duplas("Valor")
		escreva("Cidade inicial: ", cidade)
		cadeia estado= "RS"
		cidade="Vera cruz"
		escreva("\nMinha cidade é: ", cidade, " e meu estado é: ", estado)
		cadeia pais ="Brasil"
		escreva("\n", pais)
		inteiro idade = 20
		inteiro ano=2026
		inteiro data_nasc= ano-idade
		escreva("\n",5 + idade)
		escreva("\n",data_nasc)
		inteiro valor1=10
		inteiro valor2=20
		inteiro soma=valor1+valor2
		inteiro subtracao=valor1-valor2
		inteiro multiplicacao=valor1*valor2
		inteiro divisao=valor1/valor2
		inteiro resultado=0
		resultado=valor1+valor2
		resultado=valor1+valor2
		//inteiro resultado=0
		//resultado=valor1+valor2
		escreva("\n\n", soma)
		escreva("\n\n", subtracao)
		escreva("\n\n", multiplicacao)
		escreva("\n\n", divisao)

		//variantes do tipo real são numerais decimais
		real altura=1.8//Sepre usar ponto(.) para numeros decimais
		escreva("\n", altura)
		real calculo_decimal=2+altura
		escreva("\n", calculo_decimal)

	}
}
